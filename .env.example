# Environment Configuration — máy dev
# Copy thành .env. Secret KHÔNG ghi giá trị thật: chỉ tham chiếu vault://<file>/<key>
# của tung-vault, giải mã lúc chạy bằng scripts/run-dev.ps1 (secret run). VPS prod
# dùng .env riêng có giá trị thật (root:www-data 640), không dùng file này.

ASPNETCORE_ENVIRONMENT=Development

# DB qua SSH tunnel 127.0.0.1:14330 -> VPS:1433 (cổng 1433 public đã chặn).
# run-dev.ps1 tự mở tunnel. Dev và pro chung server, chỉ khác tên DB.
DB_SERVER=127.0.0.1
DB_PORT=14330
DB_USER=sa
DB_PASSWORD=vault://vps/sql_server.sa_password
DB_NAME_DEV=SuperApp-dev
DB_NAME_PRO=SuperApp-pro

# Connection string KHÔNG có Password — run-dev.ps1 gắn DB_PASSWORD vào trong process.
# Đổi DB tạm thời: run-dev.ps1 -Database SuperApp-test
ConnectionStrings__SuperAppConnection=Server=127.0.0.1,14330;Database=SuperApp-dev;User Id=sa;TrustServerCertificate=True;Encrypt=False;Connection Timeout=30;Pooling=true;Max Pool Size=200;Min Pool Size=20;
ConnectionStrings__UserProfileConnection=Server=127.0.0.1,14330;Database=SuperApp-dev;User Id=sa;TrustServerCertificate=True;Encrypt=False;Connection Timeout=30;Pooling=true;Max Pool Size=200;Min Pool Size=20;

# JWT
Jwt__Key=vault://home-ai/superapp_dev.jwt_key
Jwt__Issuer=SuperApp
Jwt__Audience=SuperApp-API
Jwt__ExpirationMinutes=15

# OAuth
OAuth__Google__ClientId=
OAuth__Google__ClientSecret=vault://home-ai/superapp_dev.google_client_secret
OAuth__Google__RedirectUri=http://localhost:3000/auth/callback

# AI - Claudible (OpenRouter)
Claudible__ApiKey=vault://home-ai/openrouter.api_key
Claudible__BaseUrl=https://openrouter.ai/api/v1
Claudible__Model=
