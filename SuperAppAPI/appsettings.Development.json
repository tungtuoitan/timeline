{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.AspNetCore.Authentication": "Debug",
      "SuperAppAPI": "Debug"
    }
  },
  "Jwt": {
    "Issuer": "SuperApp-Development",
    "Audience": "SuperApp-API-Development",
    "ExpirationMinutes": 480
  },
  "OAuth": {
    "Google": {
      "RedirectUri": "http://localhost:3001/homepage"
    }
  },
  "AllowedOrigins": [
    "http://localhost:3000",
    "http://localhost:3001",
    "http://localhost:3003",
    "http://localhost:5000"
  ],
  "Security": {
    "RequireHttps": false,
    "EnableDetailedErrors": true
  }
}
