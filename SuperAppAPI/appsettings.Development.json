{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.AspNetCore.Authentication": "Debug",
      "SuperAppAPI": "Debug"
    }
  },
  "ConnectionStrings": {
    "_comment": "Connection strings are stored in user secrets for security. To set them, run:",
    "_instructions": "dotnet user-secrets set 'ConnectionStrings:SuperAppConnection' 'Server=YOUR_SERVER;Database=Timeline-dev;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;Encrypt=False;Connection Timeout=30;'",
    "SuperAppConnection": "",
    "UserProfileConnection": ""
  },
  "Jwt": {
    "Issuer": "SuperApp-Development",
    "Audience": "SuperApp-API-Development",
    "ExpirationMinutes": 480
  },
  "OAuth": {
    "Google": {
      "RedirectUri": "http://localhost:3001/homepage"
    }
  },
  "AllowedOrigins": [
    "http://localhost:3000",
    "http://localhost:3001",
    "http://localhost:3003",
    "http://localhost:5000"
  ],
  "Security": {
    "RequireHttps": false,
    "EnableDetailedErrors": true
  }
}
