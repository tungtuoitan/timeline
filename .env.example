# Environment Configuration
# Copy this file to .env and fill in your actual values

# Application Environment (Development or Production)
# Set to "Development" for dev database, "Production" for production database
ASPNETCORE_ENVIRONMENT=Development

# Database Configuration
# Both Development and Production use server: 157.66.101.51
# Only database name differs: SuperApp-dev (Development) or SuperApp-pro (Production)

# Database Server (same for both environments)
DB_SERVER=157.66.101.51
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=YOUR_DB_PASSWORD_HERE

# Development Database
DB_NAME_DEV=SuperApp-dev

# Production Database
DB_NAME_PRO=SuperApp-pro

# Connection Strings
# For Development environment (uses SuperApp-dev database)
# To use Production: Change ASPNETCORE_ENVIRONMENT=Production AND uncomment Production connection strings below
ConnectionStrings__SuperAppConnection=Server=157.66.101.51,1433;Database=SuperApp-dev;User Id=sa;Password=YOUR_DB_PASSWORD_HERE;TrustServerCertificate=True;Encrypt=False;Connection Timeout=30;
ConnectionStrings__UserProfileConnection=Server=157.66.101.51,1433;Database=SuperApp-dev;User Id=sa;Password=YOUR_DB_PASSWORD_HERE;TrustServerCertificate=True;Encrypt=False;Connection Timeout=30;

# For Production environment (uses SuperApp-pro database)
# Uncomment these when using Production:
# ConnectionStrings__SuperAppConnection=Server=157.66.101.51,1433;Database=SuperApp-pro;User Id=sa;Password=YOUR_DB_PASSWORD_HERE;TrustServerCertificate=True;Encrypt=False;Connection Timeout=30;
# ConnectionStrings__UserProfileConnection=Server=157.66.101.51,1433;Database=SuperApp-pro;User Id=sa;Password=YOUR_DB_PASSWORD_HERE;TrustServerCertificate=True;Encrypt=False;Connection Timeout=30;

# JWT Configuration
Jwt__Key=your_super_secret_jwt_key_here_minimum_32_characters_long
Jwt__Issuer=SuperApp
Jwt__Audience=SuperApp-API
Jwt__ExpirationMinutes=60

# OAuth Configuration
OAuth__Google__ClientSecret=your_google_client_secret_here
